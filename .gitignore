# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA — we ship a hand-rolled service worker at public/sw.js (tracked).
# Old next-pwa runtime artifacts (workbox-*.js, worker-*.js, fallback-*.js)
# stay ignored in case they ever resurface from a stray local build.
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map
public/fallback-*.js

# Capacitor — track native project source, ignore generated build artifacts
ios/App/Pods
ios/App/build
ios/App/App/public
ios/DerivedData
ios/App/xcuserdata
android/.gradle
android/build
android/app/build
android/app/src/main/assets/public
android/local.properties
android/.idea
android/captures
*.iml

# Local Netlify folder
.netlify

# Local Claude Code config (preview launch.json, local settings)
.claude/

# Build artifacts
out.zip
