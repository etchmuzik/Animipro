# ─── Animipro — Environment variables ────────────────────────────────────────
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Get the Supabase values from: Supabase dashboard → Project Settings → API.

# ── Supabase (required for the app: auth + database) ─────────────────────────
# Safe to expose to the browser (RLS protects the data):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Bypasses Row-Level Security. Never expose to the browser, never
# prefix with NEXT_PUBLIC_. Used for ticket sales, payment webhooks, door scans.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Ticket QR signing (Phase 1) ──────────────────────────────────────────────
# A long random string used to HMAC-sign ticket QR codes server-side. Generate
# with:  openssl rand -hex 32
TICKET_HMAC_SECRET=replace-with-openssl-rand-hex-32

# ── Paymob (Phase 1: real EGP payments) — fill when you have a merchant acct ──
# https://accept.paymob.com → Settings → Account Info / API keys
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# Your platform's cut per ticket sale. Either a flat EGP fee or a percentage.
PLATFORM_FEE_PERCENT=10

# ── Resend (Phase 2: transactional email) ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="AnimaPro <noreply@animipro.online>"

# ── WhatsApp (Phase 2: booking confirmations) — provider TBD (360dialog/Twilio)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (used in QR links + email links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
